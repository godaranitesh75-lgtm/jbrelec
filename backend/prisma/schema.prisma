generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  phone           String               @unique
  passwordHash    String
  role            UserRole             @default(CUSTOMER)
  status          UserStatus           @default(ACTIVE)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  adminProfile    AdminProfile?
  auditLogs       AuditLog[]
  customerProfile CustomerProfile?
  deliveryProfile DeliveryBoyProfile?
  notifications   Notification[]
  statusHistory   OrderStatusHistory[] @relation("UserOrderStatusHistory")
  staffProfile    StaffProfile?
}

model CustomerProfile {
  id           String      @id @default(cuid())
  userId       String      @unique
  customerCode String      @unique
  name         String
  profileImage String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  addresses    Address[]
  cart         Cart?       @relation("CustomerCart")
  user         User        @relation(fields: [userId], references: [id])
  orders       Order[]     @relation("CustomerOrders")
  quotations   Quotation[] @relation("CustomerQuotations")
}

model StaffProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  staffCode   String   @unique
  name        String
  department  String
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model DeliveryBoyProfile {
  id               String             @id @default(cuid())
  userId           String             @unique
  deliveryBoyCode  String             @unique
  name             String
  phone            String
  vehicleType      String
  vehicleNumber    String
  status           DeliveryBoyStatus  @default(OFFLINE)
  currentLatitude  Float?
  currentLongitude Float?
  lastLocationAt   DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deliveries       Delivery[]
  user             User               @relation(fields: [userId], references: [id])
  locations        DeliveryLocation[] @relation("DeliveryBoyLocations")
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  roleTitle String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id             String           @id @default(cuid())
  sku            String           @unique
  name           String
  slug           String           @unique
  description    String
  brandId        String
  categoryId     String
  images         String[]         @default([])
  price          Float
  salePrice      Float?
  stock          Int
  status         String
  specifications Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  cartItems      CartItem[]       @relation("ProductCartItems")
  inventory      Inventory?
  orderItems     OrderItem[]
  brand          Brand            @relation(fields: [brandId], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]

  @@index([status, updatedAt])
  @@index([brandId])
  @@index([categoryId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  sku       String   @unique
  price     Float
  stock     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  available Int
  reserved  Int      @default(0)
  sold      Int      @default(0)
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
}

model Cart {
  id         String          @id @default(cuid())
  customerId String          @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  customer   CustomerProfile @relation("CustomerCart", fields: [customerId], references: [id])
  items      CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  unitPrice Float
  total     Float
  cart      Cart    @relation(fields: [cartId], references: [id])
  product   Product @relation("ProductCartItems", fields: [productId], references: [id])
}

model Address {
  id         String          @id @default(cuid())
  customerId String
  label      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  latitude   Float?
  longitude  Float?
  isDefault  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  customer   CustomerProfile @relation(fields: [customerId], references: [id])
  orders     Order[]         @relation("AddressOrders")
}

model Order {
  id                String               @id @default(cuid())
  orderNumber       String               @unique
  customerId        String
  status            OrderStatus          @default(PENDING)
  subtotal          Float
  tax               Float
  deliveryFee       Float
  total             Float
  shippingAddressId String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  delivery          Delivery?
  customer          CustomerProfile      @relation("CustomerOrders", fields: [customerId], references: [id])
  shippingAddress   Address              @relation("AddressOrders", fields: [shippingAddressId], references: [id])
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  payment           Payment?
  refund            Refund?
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float
  total     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  provider  String
  amount    Float
  status    PaymentStatus
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  order     Order         @relation(fields: [orderId], references: [id])
}

model Refund {
  id        String        @id @default(cuid())
  orderId   String        @unique
  amount    Float
  reason    String
  status    PaymentStatus
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  order     Order         @relation(fields: [orderId], references: [id])
}

model Delivery {
  id                  String              @id @default(cuid())
  orderId             String              @unique
  status              DeliveryStatus      @default(UNASSIGNED)
  deliveryBoyId       String?
  pickupLocation      Json?
  deliveryLocation    Json?
  assignedAt          DateTime?
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  assignedDeliveryBoy DeliveryBoyProfile? @relation(fields: [deliveryBoyId], references: [id])
  order               Order               @relation(fields: [orderId], references: [id])
  locations           DeliveryLocation[]
}

model DeliveryLocation {
  id            String             @id @default(cuid())
  deliveryId    String
  deliveryBoyId String
  latitude      Float
  longitude     Float
  accuracy      Float?
  recordedAt    DateTime           @default(now())
  deliveryBoy   DeliveryBoyProfile @relation("DeliveryBoyLocations", fields: [deliveryBoyId], references: [id])
  delivery      Delivery           @relation(fields: [deliveryId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])
}

model Quotation {
  id         String          @id @default(cuid())
  customerId String
  subject    String
  details    String
  status     String          @default("PENDING")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  customer   CustomerProfile @relation("CustomerQuotations", fields: [customerId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  UserRole
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  changedById String
  note        String?
  createdAt   DateTime    @default(now())
  changedBy   User        @relation("UserOrderStatusHistory", fields: [changedById], references: [id])
  order       Order       @relation(fields: [orderId], references: [id])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum UserRole {
  ADMIN
  STAFF
  DELIVERY_BOY
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  READY_FOR_DISPATCH
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  ACCEPTED
  PICKED_UP
  ON_THE_WAY
  ARRIVED
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryBoyStatus {
  ONLINE
  OFFLINE
  ON_DELIVERY
  PAUSED
  SUSPENDED
}

enum NotificationType {
  ORDER_CONFIRMED
  ORDER_PACKED
  ORDER_ASSIGNED
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  ORDER_CANCELLED
  REFUND_STARTED
  REFUND_COMPLETED
  DELIVERY_ASSIGNED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}
